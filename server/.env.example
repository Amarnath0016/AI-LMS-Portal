# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication Secrets (Replace with high-entropy cryptographic strings)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin 2FA Second Factor Access Code
ADMIN_ACCESS_CODE=123456

# Database Configuration (Required: MongoDB via Mongoose)
MONGO_URI=mongodb://127.0.0.1:27017/uptoskills

# SMTP Email Configuration (Optional: In development, OTP is logged to console if SMTP is unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="UptoSkills AI Security" <noreply@uptoskills.com>

# AI Engine API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
